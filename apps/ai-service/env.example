# AI Service 환경변수
AI_SERVICE_PORT=3004

# LLM 프로바이더 선택 (claude | openai | gemini | groq)
LLM_PROVIDER=claude

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI (LLM + 임베딩 모두 사용)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (로컬 LLM — API 키 불필요)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

# MongoDB (벡터 저장소 + 문서 메타데이터)
MONGODB_VECTOR_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=ai_service

# Redis (LLM 응답 캐싱 + Bull Queue)
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379

# LLM 응답 캐시 TTL (초, 기본값 3600)
LLM_CACHE_TTL_SECONDS=3600

# 시맨틱 캐시 활성화 여부 (기본값 true)
SEMANTIC_CACHE_ENABLED=true

# 시맨틱 캐시 유사도 임계값 (0~1, 기본값 0.85)
SEMANTIC_CACHE_THRESHOLD=0.85

# 시맨틱 캐시 TTL (초, 기본값 3600)
SEMANTIC_CACHE_TTL_SECONDS=3600

# 임베딩 벡터 차원 (OpenAI text-embedding-3-small=1536, Ollama bge-m3=1024)
EMBEDDING_DIMENSION=1536

# 가드레일 활성화 여부 (기본값 true — false 로 설정 시 프롬프트 인젝션 방어 비활성화)
GUARDRAIL_ENABLED=true

# CORS 허용 오리진 (쉼표 구분, 기본값 http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:5175

# Knowledge 관리 API 인증 키 (미설정 시 인증 생략 — 개발 환경 전용)
ADMIN_API_KEY=your-admin-api-key

# 하이브리드 검색 — 리랭커 API (Cohere, Jina 등 호환)
RERANKER_API_URL=https://api.cohere.com/v1/rerank
RERANKER_API_KEY=your-reranker-api-key
RERANKER_TOP_N=10
# RERANKER_ENABLED=false 로 설정 시 리랭킹 비활성화 (기본값 true)
RERANKER_ENABLED=true

# 하이브리드 검색 후보 개수 (dense + lexical 각각 검색, 기본값 20)
HYBRID_CANDIDATE_K=20

# RRF 융합 파라미터 k (기본값 60)
RRF_K=60

# HyDE 최대 단어 수 (이하 질문에 HyDE 적용, 기본값 5)
HYDE_MAX_QUERY_WORDS=5

# ── Phase 8: OTel GenAI 계측 ─────────────────────────────────────────────────

# OTLP 수신 엔드포인트 (설정하지 않으면 OTel 초기화 건너뜀)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 서비스 이름 (기본값 ai-service)
OTEL_SERVICE_NAME=ai-service

# RAGAS 평가 샘플링 비율 (0.0~1.0, 기본값 0.1)
RAGAS_SAMPLE_RATE=0.1

# ── Phase 9: Agentic RAG ─────────────────────────────────────────────────────

# Agentic 루프 최대 반복 횟수 (1~10, 기본값 2 — 높일수록 정확하지만 느려짐)
AGENTIC_MAX_ITERATIONS=2

# Agentic 루프 최대 토큰 예산 (기본값 30000)
AGENTIC_TOKEN_BUDGET=30000

# Agentic 루프 타임아웃 (밀리초, 기본값 20000)
AGENTIC_TIMEOUT_MS=20000

# Agentic 루프 신뢰도 임계값 (0.0~1.0, 기본값 0.6 — 낮을수록 빠르지만 재시도 적음)
AGENTIC_CONFIDENCE_THRESHOLD=0.6

# ── Phase 7: LLM 게이트웨이 ──────────────────────────────────────────────────

# 폴백 체인 (콤마 구분, 앞에서부터 순서대로 시도)
LLM_FALLBACK_CHAIN=claude-sonnet-4-6,gpt-4o,gemini-2.0-flash

# Circuit Breaker 리셋 타임아웃 (밀리초, 기본값 60000)
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# 모델별 토큰 단가 (USD per 1M tokens, JSON 형식)
MODEL_COST_TABLE={"claude-sonnet-4-6":{"prompt":3.0,"completion":15.0},"gpt-4o":{"prompt":2.5,"completion":10.0},"gemini-2.0-flash":{"prompt":0.075,"completion":0.30}}

# ── LangSmith 트레이싱 ────────────────────────────────────────────────────────

# LangSmith 트레이싱 활성화 여부 (기본값 false)
LANGSMITH_TRACING=false

# LangSmith API 키 (https://smith.langchain.com 에서 발급)
LANGSMITH_API_KEY=

# LangSmith 프로젝트 이름 (기본값 ai-service)
LANGSMITH_PROJECT=ai-service

# LangSmith 엔드포인트 (기본값 https://api.smith.langchain.com)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── RAGAS LLM 평가 ────────────────────────────────────────────────────────────

# LLM 기반 RAGAS 평가 활성화 여부 (false=휴리스틱, true=ChatOpenAI 호출, 기본값 false)
RAGAS_LLM_EVAL_ENABLED=false
